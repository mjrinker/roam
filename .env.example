# ── Supabase ──────────────────────────────────────────────────────────────
# The app code only reads the two below (plus SUPABASE_SERVICE_ROLE_KEY) —
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are read in the
# BROWSER (sign-in, sign-out), and the NEXT_PUBLIC_ prefix is required or
# Next.js won't inline them into the client bundle. Same values as the
# unprefixed SUPABASE_URL/SUPABASE_ANON_KEY below — set both.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Everything below this line is whatever Vercel's Supabase integration
# auto-provisions — kept here for reference / local-dev parity, but not all
# of it is currently read by the app.
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Project Settings → API → service_role (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Supabase's newer publishable/secret key pair (replacing anon/service_role
# long-term) — not used by this app yet, kept for when we migrate to it.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection for Drizzle migrations.
# Project Settings → Database → Connection string → URI (use the "Transaction" pooler
# connection on port 6543 for serverless-friendly pooled access at runtime, and the
# direct :5432 connection for running migrations).
POSTGRES_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── Box ───────────────────────────────────────────────────────────────────
# Box Developer Console → your Custom App → Configuration.
# Server auth using Client Credentials Grant (CCG) with a service account.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
# The Box folder ID of the root "Movies" library (right-click folder in Box → Folder ID
# is the trailing number in the URL).
BOX_MOVIES_FOLDER_ID=
# Optional: root folder ID for a "TV Shows" library.
BOX_SHOWS_FOLDER_ID=

# ── TMDB ──────────────────────────────────────────────────────────────────
# https://www.themoviedb.org/settings/api → API Read Access Token (v4 auth)
TMDB_READ_ACCESS_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────
# Used to build absolute URLs (invite links, cron auth) — your Vercel deployment URL
# locally this is fine as http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret Vercel Cron must send as `Authorization: Bearer <value>` to hit
# /api/cron/scan. Generate with `openssl rand -hex 32`.
CRON_SECRET=
