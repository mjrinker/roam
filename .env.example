# ── Supabase ──────────────────────────────────────────────────────────────
# The app code only reads the two below (plus SUPABASE_SERVICE_ROLE_KEY) —
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are read in the
# BROWSER (sign-in, sign-out), and the NEXT_PUBLIC_ prefix is required or
# Next.js won't inline them into the client bundle. Same values as the
# unprefixed SUPABASE_URL/SUPABASE_ANON_KEY below — set both.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Everything below this line is whatever Vercel's Supabase integration
# auto-provisions — kept here for reference / local-dev parity, but not all
# of it is currently read by the app.
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Project Settings → API → service_role (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Supabase's newer publishable/secret key pair (replacing anon/service_role
# long-term) — not used by this app yet, kept for when we migrate to it.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection for Drizzle migrations.
# Project Settings → Database → Connection string → URI (use the "Transaction" pooler
# connection on port 6543 for serverless-friendly pooled access at runtime, and the
# direct :5432 connection for running migrations).
POSTGRES_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── Box ───────────────────────────────────────────────────────────────────
# Box Developer Console → your Custom App → Configuration → OAuth 2.0.
# These identify THIS APP to Box for the OAuth handshake — one app
# registration, shared by every server (each server's admin separately
# connects their own Box account; there's no service account anymore).
# Register redirect URIs for both http://localhost:3000/api/box/callback
# and your production URL's /api/box/callback.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# ── Other storage providers (each optional: unset, it isn't offered) ──────
# Dropbox: dropbox.com/developers/apps, Scoped access + Full Dropbox, permissions files.metadata.read and
# files.content.read, redirect URI https://<site>/api/dropbox/callback. (Development apps may link 50 accounts;
# apply for production before that: the /platform page shows the count.)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# OneDrive (personal, work or school): portal.azure.com App registrations, redirect URI
# https://<site>/api/onedrive/callback, delegated permissions Files.Read.All, User.Read, offline_access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Google Drive: Google Cloud Console, Drive API, OAuth client (Web), scope drive.readonly, redirect URI
# https://<site>/api/google/callback; publish the consent screen to "In production".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Drive can stream through a free Cloudflare Worker (see cloudflare/stream-worker/README.md) instead of
# through this app. Both or neither.
STREAM_WORKER_URL=
STREAM_SECRET=

# ── TMDB ──────────────────────────────────────────────────────────────────
# https://www.themoviedb.org/settings/api → API Read Access Token (v4 auth)
TMDB_READ_ACCESS_TOKEN=

# ── OMDb ─────────────────────────────────────────────────────────────────
# IMDb rating + Rotten Tomatoes Tomatometer for movies/shows (optional — left
# unset, scores just never populate). Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# ── Security ─────────────────────────────────────────────────────────────
# Encrypts every storage connection's access/refresh tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Rotating this key orphans every stored token (they become undecryptable)
# — every connection would need reconnecting. There's no
# rotation tooling yet; treat this as a long-lived secret.
TOKEN_ENCRYPTION_KEY=

# ── App ───────────────────────────────────────────────────────────────────
# Used to build absolute URLs (invite links, cron auth) — your Vercel deployment URL
# locally this is fine as http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown on the Privacy and Terms pages as the contact address (optional).
NEXT_PUBLIC_CONTACT_EMAIL=
# Google Search Console's verification tag content (optional; adds the meta tag Google asks for).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# A short hostname to type on a TV to reach the TV app (optional).
NEXT_PUBLIC_TV_HOST=
# Shared secret Vercel Cron must send as `Authorization: Bearer <value>` to hit
# /api/cron/refresh (the daily TMDB refresh, scheduled in vercel.json) and /api/cron/scan.
# Generate with `openssl rand -hex 32`. Set it for the Production environment.
CRON_SECRET=

# ── CAPTCHA (optional) ────────────────────────────────────────────────────
# Cloudflare Turnstile on sign-in. Setting the PUBLIC site key shows the widget and sends its token with every
# email, password and guest sign-in. Set it (and deploy) BEFORE turning "CAPTCHA protection" on in Supabase
# (Authentication > Attack Protection), whose settings take the SECRET key: once Supabase requires a token, a
# build without the widget cannot sign anyone in. Leave blank for no CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Abuse limits (all optional — sane defaults if unset) ──────────────────
# Sign-up is open to anyone, so these bound what a single account can do.
# Max servers a single user can own (not counting servers they've joined).
MAX_SERVERS_PER_USER=3
# Pending (unaccepted) invitations one server may have at once.
MAX_PENDING_INVITES_PER_SERVER=25
# The public demo's total plays per day across all visitors.
DEMO_PLAYS_PER_DAY=300

# ── Subtitles from OpenSubtitles (optional) ────────────────────────────────
# Lets viewers search OpenSubtitles for a subtitle to use while watching (nothing is stored). Needs an API key
# (opensubtitles.com > your profile > API consumers) and the login of an OpenSubtitles account; the account's
# daily download allowance is shared by everyone on the server. Leave blank to only allow loading subtitle files.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
