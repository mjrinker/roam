<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/PlayerScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/timeline.brs" />
  <interface>
    <field id="params" type="assocarray" />
    <field id="route" type="assocarray" alwaysNotify="true" />
    <function name="activate" />
  </interface>
  <children>
    <Video id="video" translation="[0,0]" width="1280" height="720" />
    <Group id="skipBox" translation="[880,560]" visible="false">
      <Rectangle width="340" height="64" color="0xFFFFFFE6" />
      <Label id="skipLabel" translation="[0,0]" width="340" height="40" horizAlign="center" vertAlign="center" color="0x0B0B10FF" font="font:MediumBoldSystemFont" />
      <Label id="skipHint" translation="[0,38]" width="340" height="24" horizAlign="center" color="0x444444FF" font="font:SmallestSystemFont" text="Press Down" />
    </Group>
    <Label id="subtitleText" translation="[140,590]" width="1000" height="100" wrap="true" horizAlign="center" vertAlign="bottom" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" visible="false" />
    <Label id="status" translation="[140,120]" width="1000" wrap="true" lineSpacing="6" color="0xECECF1FF" font="font:MediumSystemFont" visible="false" />
    <Timer id="tick" repeat="true" duration="0.25" />
    <Timer id="saveTimer" repeat="true" duration="15" />
    <Timer id="beatTimer" repeat="true" duration="30" />
    <Timer id="noticeTimer" repeat="false" duration="7" />
  </children>
</component>
